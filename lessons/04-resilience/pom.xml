<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.learning</groupId>
        <artifactId>spring-boot-interview-prep</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>04-resilience</artifactId>
    <name>04 :: Caching &amp; Resilience</name>
    <description>Redis caching, @Async, @Scheduled, Resilience4j, RestClient</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          REQUIRED by spring.data.redis.lettuce.pool.enabled=true, and NOT pulled in by the
          starter. Without it startup fails with a bare
              NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig
          which never mentions that connection pooling is the reason.

          Worth knowing: Lettuce connections are thread-safe and multiplexed, so a single
          shared connection is usually enough — pooling only helps for blocking commands
          or dedicated connections. Boot leaves the dependency out on purpose.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!--
          Resilience4j replaced Hystrix (which went maintenance-only in 2018). It is a
          lightweight functional library built on decorators — no separate thread pool per
          command by default, unlike Hystrix's thread isolation.
          resilience4j-spring-boot3 wires up the annotations, config properties and the
          actuator/metrics integration.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>
        <!-- Required for the annotations to be applied via AOP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          No redis-specific Testcontainers module needed: a plain GenericContainer running
          the redis image plus @ServiceConnection("redis") is enough for Boot to contribute
          spring.data.redis.host/port. Fewer dependencies, same result.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
